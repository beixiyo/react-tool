    "@jl-org/http": "^1.0.7",
    "@jl-org/react-router": "^0.0.3",
    "@jl-org/tool": "^3.3.8",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@zumer/snapdom": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "fabric": "^6.6.1",
    "framer-motion": "^11.5.6",
    "jotai": "^2.16.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.514.0",
