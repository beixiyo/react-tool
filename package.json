{
  "name": "react-tool",
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:utils": "pnpm --filter utils build",
    "build:hooks": "pnpm --filter hooks build",
    "build:app": "pnpm --filter app build",
    "build:llm-api": "pnpm --filter llm-api build",
    "---lint---": "---",
    "lint": "turbo lint",
    "lint:utils": "pnpm --filter utils lint",
    "lint:hooks": "pnpm --filter hooks lint",
    "lint:app": "pnpm --filter app lint",
    "lint:llm-api": "pnpm --filter llm-api lint"
  },
  "dependencies": {
    "@jl-org/http": "^1.0.7",
    "@jl-org/tool": "^3.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.2.0",
    "@eslint-react/eslint-plugin": "^1.26.2",
    "@jl-org/eslint-plugins": "^1.0.0",
    "@jl-org/js-to-style": "^1.0.0",
    "@jl-org/ts-tool": "^0.0.8",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "code-inspector-plugin": "^0.20.3",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "glob": "^11.0.3",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass": "^1.77.8",
    "tailwindcss": "3.4.17",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^0.18.2",
    "vite": "6.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-env-parse": "^1.0.15"
  }
}