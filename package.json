{
  "name": "react-tool",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "dev": "nx run app:dev",
    "build": "nx run-many -t build --parallel=2",
    "build:utils": "nx run utils:build",
    "build:comps": "nx run comps:build",
    "build:hooks": "nx run hooks:build",
    "build:app": "nx run app:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "---lint---": "---",
    "lint": "nx run-many -t lint --projects app,comps,hooks,utils,config",
    "lint:utils": "nx run utils:lint",
    "lint:hooks": "nx run hooks:lint",
    "lint:app": "nx run app:lint",
    "lint:config": "nx run config:lint",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "fix": "pnpm run lint && dprint fmt",
    "graph": "nx graph"
  },
  "dependencies": {
    "@jl-org/cvs": "^3.0.0",
    "@jl-org/http": "^1.2.5",
    "@jl-org/react-router": "^0.1.3",
    "@jl-org/tool": "^4.0.3",
    "@zumer/snapdom": "^1.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "fabric": "^6.6.1",
    "localforage": "^1.10.0",
    "lucide-react": "^0.514.0",
    "node-vibrant": "^4.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@jl-org/eslint-plugins": "^1.0.1",
    "@jl-org/js-to-style": "^1.0.1",
    "@jl-org/optimize-assets-size": "^0.0.4",
    "@jl-org/ts-tool": "^0.0.8",
    "@tailwindcss/vite": "^4.2.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "code-inspector-plugin": "^1.5.1",
    "jsdom": "^29.1.1",
    "nx": "^22.1.3",
    "oxlint": "^1.78.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "sass-embedded": "^1.93.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.2.0",
    "vite": "8.0.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-env-parse": "^1.0.15",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
