{
  "$schema": "https://json.schemastore.org/nx-project",
  "name": "utils",
  "projectType": "library",
  "root": "packages/utils",
  "sourceRoot": "packages/utils/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter utils build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter utils lint"
      }
    }
  },
  "implicitDependencies": ["config"]
}

