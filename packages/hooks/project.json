{
  "$schema": "https://json.schemastore.org/nx-project",
  "name": "hooks",
  "projectType": "library",
  "root": "packages/hooks",
  "sourceRoot": "packages/hooks/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter hooks build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter hooks lint"
      }
    }
  },
  "implicitDependencies": ["config", "styles"]
}

