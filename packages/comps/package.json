{
  "name": "comps",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/comps/src/index.d.ts",
  "exports": {
    "./index.css": "./dist/index.css",
    ".": {
      "require": {
        "types": "./dist/comps/src/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/comps/src/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --config ../../vitest.config.ts packages/comps/src",
    "lint": "eslint ./src --fix --quiet"
  },
  "dependencies": {
    "@jl-org/tool": "^4.0.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "hooks": "workspace:*",
    "lucide-react": "^0.514.0",
    "motion": "^12.27.0",
    "styles": "workspace:*",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@jl-org/react-router": "^0.1.3",
    "@jl-org/ts-tool": "^0.0.8",
    "config": "workspace:*"
  },
  "peerDependencies": {
    "i18n": "workspace:*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
