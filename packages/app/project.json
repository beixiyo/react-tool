{
  "$schema": "https://json.schemastore.org/nx-project",
  "name": "app",
  "projectType": "application",
  "root": "packages/app",
  "sourceRoot": "packages/app/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter app dev"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter app build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter app lint"
      }
    }
  },
  "implicitDependencies": ["comps", "hooks", "utils", "styles", "config"]
}

